#!/bin/sh

set -eu

repo_root=$(git rev-parse --show-toplevel)
service_worker="$repo_root/sw.js"

current_version=$(sed -n "s/^const CACHE_VERSION = 'v\([0-9][0-9]*\)';$/\1/p" "$service_worker")

if [ -z "$current_version" ]; then
  echo "Impossible de trouver CACHE_VERSION dans sw.js" >&2
  exit 1
fi

next_version=$((current_version + 1))
sed -i "s/^const CACHE_VERSION = 'v[0-9][0-9]*';$/const CACHE_VERSION = 'v${next_version}';/" "$service_worker"
git add "$service_worker"
